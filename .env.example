# 開発用 DB 接続設定。このファイルをコピーして .env を作成する（.env は gitignore 済み）。
# 既定値のままなら .env なしでも動く（compose・アプリとも crowdodge が既定）。
#
# 注意: .env は docker compose が読み込んで DB コンテナに注入する。
#       ホスト起動するアプリ(./gradlew :app:run) は .env を自動では読まないため、
#       既定値から変えた場合はアプリ側にも渡すこと（例: set -a; source .env; set +a）。

# アプリ(application.conf の ${?DB_*})が使う DB 接続設定。
# Cloud Run で Supabase の transaction-mode pooler を使う場合:
#   DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
#   DB_PORT=6543
#   DB_NAME=postgres
#   DB_USER=postgres.xxxxx
#   DB_PASSWORD=<password>
#   DB_SSL_MODE=require
#   DB_PGBOUNCER=true
DB_NAME=crowdodge
DB_USER=crowdodge
DB_PASSWORD=crowdodge
DB_PORT=5432
DB_SSL_MODE=disable
DB_PGBOUNCER=false

# アプリ(ホスト起動)が接続するホスト。compose の DB はこのホストの DB_PORT に公開される。
DB_HOST=localhost

# Flyway migration 用 DB 接続設定。
# Cloud Run Jobs で Supabase の session-mode pooler を使う場合:
#   MIGRATION_DB_HOST=aws-1-ap-northeast-1.pooler.supabase.com
#   MIGRATION_DB_PORT=5432
#   MIGRATION_DB_NAME=postgres
#   MIGRATION_DB_USER=postgres.xxxxx
#   MIGRATION_DB_PASSWORD=<password>
#   MIGRATION_DB_SSL_MODE=require
MIGRATION_DB_HOST=localhost
MIGRATION_DB_PORT=5432
MIGRATION_DB_NAME=crowdodge
MIGRATION_DB_USER=crowdodge
MIGRATION_DB_PASSWORD=crowdodge
MIGRATION_DB_SSL_MODE=disable
